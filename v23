##############################################################################
# capacity_audit_debug.py
#
# Updates:
# • Handles 'Billable_Status' column (Billable vs Non-Billable)
# • Includes both Estimated Effort and Actual Effort in capacity logic
# • Adjusts forecast/gap using Non-Billable values
##############################################################################

import re, sys, logging, math
from pathlib import Path
from datetime import timedelta
import numpy as np
import pandas as pd
from pandas.tseries.offsets import Week
from sklearn.model_selection import TimeSeriesSplit
from sklearn.metrics import mean_absolute_error

try:
    from xgboost import XGBRegressor
    USE_XGB = True
except ImportError:
    from sklearn.ensemble import RandomForestRegressor
    USE_XGB = False

# ───────────── PATHS ─────────────────────────────────────────────
STR_PATH   = Path(r"C:\data\STR_cleaned.xlsx")
CORE_PATH  = Path(r"C:\data\CoreAlm_master.xlsx")
MILE_PATH  = Path(r"C:\data\Milestone_tracker.xlsx")
EMP_PATH   = Path(r"C:\data\Employee_Whitelist.xlsx")
OUT_PATH   = Path(r"capacity_audit.xlsx")

# ───────────── PARAMETERS ───────────────────────────────────────
RUN_DATE       = pd.Timestamp.today().normalize()
HORIZON_WEEKS  = 4
UTIL_TARGET    = 0.94
HOURS_PRE25    = 43
HOURS_2025_ON  = 40
MAX_MILESTONE_ROWS = 30

COL_EMAIL      = "Resource_Email"
COL_HOURS      = "Total_Hours_By_week"
COL_WEEK       = "Week"
COL_STR_PROJ   = "BG_Project_Code"
COL_CORE_PROJ  = "Project STR Code"
COL_MILE_PROJ  = "Project_Code"

logging.basicConfig(level=logging.INFO,
                    format="%(asctime)s | %(levelname)-8s | %(message)s",
                    datefmt="%H:%M:%S")

# ───────────── REGEX + HELPERS ──────────────────────────────────
ISO_RE = re.compile(r"(?P<yr>\d{4})[-_./\\s]*W?(?P<wk>\\d{1,2})\\b", re.I)

def assure(p): 
    if not p.exists(): logging.error("File not found: %s", p); sys.exit(1)

def load(p):
    assure(p)
    return pd.read_excel(p)

def parse_week(val):
    if pd.isna(val): return pd.NaT
    ts = pd.to_datetime(val, errors="coerce")
    if not pd.isna(ts): return ts.normalize()
    m = ISO_RE.search(str(val).strip())
    if m:
        y, w = m.group("yr"), m.group("wk").zfill(2)
        return pd.to_datetime(f"{y}-W{w}-1", format="%G-W%V-%u", errors="coerce")
    return pd.NaT

def clean_numeric(df, cols):
    return df[cols].apply(pd.to_numeric, errors="coerce").replace([np.inf, -np.inf], np.nan).fillna(0.0).astype("float32")

def add_format(wb, **k):
    return wb.add_format(k)

def add_feats(d):
    for l in LAGS:
        d[f"lag{l}"] = d.groupby("Employee")["TotalHours"].shift(l)
    for r in ROLLS:
        d[f"roll{r}"] = d.groupby("Employee")["TotalHours"].shift(1).rolling(r, min_periods=1).mean()
    iso = d["Week"].dt.isocalendar()
    d["ISO_Year"] = iso["year"].astype("float32")
    d["WeekOfYear"] = iso["week"].astype("float32")
    return d

# ───────────── 1. LOAD FILES ────────────────────────────────────
df_str  = load(STR_PATH)
df_core = load(CORE_PATH)
df_mile = load(MILE_PATH)
df_emp  = load(EMP_PATH)

# ───────────── 2. CLEANING & STATUS CLASSIFICATION ──────────────
df_str[COL_EMAIL] = df_str[COL_EMAIL].astype(str).str.strip().str.lower()
df_emp.iloc[:,0]  = df_emp.iloc[:,0].astype(str).str.strip().str.lower()
EMP_SET = set(df_emp.iloc[:,0])

df_str = df_str[df_str[COL_EMAIL].isin(EMP_SET)]
df_str[COL_WEEK] = df_str[COL_WEEK].apply(parse_week)
df_str = df_str[df_str[COL_WEEK].notna()]

df_str["Billable_Status"] = df_str["Billable_Status"].astype(str).str.strip().str.lower()
df_str["BillableHours"] = np.where(df_str["Billable_Status"] == "billable", df_str[COL_HOURS], 0.0)
df_str["NonBillableHours"] = np.where(df_str["Billable_Status"] != "billable", df_str[COL_HOURS], 0.0)

# ───────────── 3. AGGREGATION ────────────────────────────────────
df_agg = df_str.groupby([COL_EMAIL, COL_WEEK], as_index=False).agg(
    TotalHours=(COL_HOURS, "sum"),
    BillableHours=("BillableHours", "sum"),
    NonBillableHours=("NonBillableHours", "sum")
).rename(columns={COL_EMAIL: "Employee", COL_WEEK: "Week"})

df_agg["NominalCap"] = np.where(df_agg["Week"] < pd.Timestamp("2025-01-01"), HOURS_PRE25, HOURS_2025_ON)

# ───────────── 4. ROLL/LAG SETUP ────────────────────────────────
weeks_count = df_agg["Week"].dt.to_period('W').nunique()
if weeks_count >= 8: LAGS, ROLLS = (1,2,3,4), (4,8,12)
elif weeks_count >= 5: LAGS, ROLLS = (1,2), (3,6)
else: LAGS, ROLLS = (1,), (2,)

df_feat = add_feats(df_agg.copy())
emp2id = {e:i for i,e in enumerate(df_feat["Employee"].unique())}
df_feat["EmpID"] = df_feat["Employee"].map(emp2id).astype("float32")

FEATS = ["ISO_Year", "WeekOfYear", "EmpID", "NominalCap"] + [c for c in df_feat.columns if c.startswith(("lag","roll"))]
X_train = clean_numeric(df_feat, FEATS).to_numpy()
y_train = df_feat["TotalHours"].astype("float32").values

# ───────────── 5. MODEL ─────────────────────────────────────────
model = XGBRegressor(n_estimators=500, learning_rate=0.05, max_depth=6,
                     subsample=0.8, colsample_bytree=0.8,
                     objective="reg:squarederror", n_jobs=-1, random_state=42) if USE_XGB \
        else RandomForestRegressor(n_estimators=400, n_jobs=-1, random_state=42)

for tr, vl in TimeSeriesSplit(5).split(X_train):
    model.fit(X_train[tr], y_train[tr])

model.fit(X_train, y_train)

# ───────────── 6. FORECAST ──────────────────────────────────────
blocks = []
latest = df_feat.sort_values(["Employee", "Week"]).groupby("Employee").tail(1)
for h in range(HORIZON_WEEKS):
    base = latest.copy() if h==0 else blocks[-1].copy()
    base["Week"] += Week(1)
    for l in LAGS:
        base[f"lag{l}"] = base["TotalHours"] if l==1 else base[f"lag{l-1}"]
    base = add_feats(base)
    base["EmpID"] = base["Employee"].map(emp2id)
    base["TotalHours"] = model.predict(clean_numeric(base, FEATS)).astype("float32")
    base["WeekIdx"] = h + 1
    blocks.append(base)

fc_df = pd.concat(blocks, ignore_index=True)

# ───────────── 7. GAP CALCULATION ───────────────────────────────
summary = []
for wk in range(1, HORIZON_WEEKS + 1):
    wkdf = fc_df[fc_df["WeekIdx"] == wk].copy()
    cap = wkdf["NominalCap"].sum()
    dem = wkdf["TotalHours"].sum()
    # Map back to real Non-Billable for reporting
    merged = wkdf.merge(df_agg[["Employee", "Week", "NonBillableHours"]], on=["Employee", "Week"], how="left")
    nonbill = merged["NonBillableHours"].fillna(0.0).sum()
    billable_gap = max(0, UTIL_TARGET * cap - dem)
    total_gap = billable_gap + nonbill
    need = int(math.ceil(total_gap / 40))  # Assume 40-hour block as MED_WK_H fallback
    summary.append((wk, cap, dem, billable_gap, nonbill, total_gap, need))

# ───────────── 8. EXCEL OUTPUT ──────────────────────────────────
with pd.ExcelWriter(OUT_PATH, engine="xlsxwriter") as xl:
    wb = xl.book
    hdr = add_format(wb, bold=True, bg_color="#D9E1F2", border=1)
    num = add_format(wb, num_format="#,##0", border=1)
    warn = add_format(wb, num_format="#,##0", bg_color="#FFE599", border=1)

    summary_df = pd.DataFrame(summary, columns=["Week", "Capacity", "Demand", "BillableGap", "NonBillable", "TotalGap", "Projects"])
    summary_df.to_excel(xl, sheet_name="Summary", index=False)
    ws = xl.sheets["Summary"]
    ws.freeze_panes(1, 0)
    for col, w in zip("ABCDEFG", [6, 12, 12, 12, 12, 12, 10]):
        ws.set_column(f"{col}:{col}", w)
    ws.set_row(0, None, hdr)
    for i in range(1, len(summary_df)+1):
        ws.write_row(i, 0, summary_df.iloc[i-1], num)

    fc_df.to_excel(xl, sheet_name="Weekly_Forecast", index=False)
    df_feat.tail(800).to_excel(xl, sheet_name="Raw_Data", index=False)

# ───────────── 9. CONSOLE SUMMARY ──────────────────────────────
print("="*70)
print(f"Weekly capacity snapshot (util target {UTIL_TARGET:.0%}) with Non-Billable impact")
print("="*70)
for row in summary:
    print(f"Week {row[0]:<2d} | Cap {row[1]:6,.0f} | Dem {row[2]:6,.0f} | Gap {row[3]:6,.0f} | NB {row[4]:6,.0f} | TotalGap {row[5]:6,.0f} | Proj {row[6]}")
print("="*70)
print("Workbook saved to", OUT_PATH)
