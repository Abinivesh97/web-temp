# regex that matches *any* ISO-week string “2018W25”, “2018-W25”, …
ISO_RE = re.compile(r"(?P<yr>\d{4})\s*[-_/]?\s*W?\s*(?P<wk>\d{2})",
                    re.I)

# ─── LITTLE HELPERS ─────────────────────────────────────────────────────
def assure(path):
    if not path.exists():
        logging.error("File not found: %s", path); sys.exit(1)

def load_xlsx(path):
    assure(path); return pd.read_excel(path)

def parse_week(val):
    """Return normalized Monday Timestamp or NaT."""
    if pd.isna(val):                  # empty cell
        return pd.NaT
    ts = pd.to_datetime(val, errors="coerce")
    if not pd.isna(ts):               # already a valid date
        return ts.normalize()
    m = ISO_RE.search(str(val).strip())
    if m:                             # ISO-week variant
        y, w = m.group("yr","wk")
        return pd.to_datetime(f"{y}-W{w}-1", format="%G-W%V-%u",
                              errors="coerce")
    return pd.NaT                     # still unparseable

def clean_numeric(df, cols):
    """float32, NaN/∞ coerced to 0 so sklearn never explodes."""
    return (df[cols]
              .apply(pd.to_numeric, errors="coerce")
              .replace([np.inf, -np.inf], np.nan)
              .fillna(0.0)
              .astype("float32"))

