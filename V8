import re, sys, logging
from pathlib import Path
from dataclasses import dataclass
from datetime import datetime, timedelta

import numpy as np
import pandas as pd
from pandas.tseries.offsets import Week
from sklearn.model_selection import TimeSeriesSplit
from sklearn.metrics import mean_absolute_error

try:
    from xgboost import XGBRegressor
    HAS_XGB = True
except ImportError:
    from sklearn.ensemble import RandomForestRegressor
    HAS_XGB = False

# ───────────────────────── USER-EDITABLE PATHS ──────────────────────────
STR_PATH   = Path(r"C:\data\STR_cleaned.xlsx")
CORE_PATH  = Path(r"C:\data\CoreAlm_master.xlsx")
MILE_PATH  = Path(r"C:\data\Milestone_tracker.xlsx")
EMP_PATH   = Path(r"C:\data\employee_whitelist.xlsx")
# ────────────────────────────────────────────────────────────────────────

RUN_DATE     = pd.Timestamp("today").normalize()   # anchor
HORIZON_DAYS = 30                                  # look-ahead
UTIL_TARGET  = 0.94
HOURS_PRE25  = 43
HOURS_2025   = 40

# regex for ISO week codes
ISO_RE = re.compile(r"^(?P<yr>\d{4})[-_]?W?(?P<wk>\d{2})$", re.I)

# logging
logging.basicConfig(level=logging.INFO,
                    format="%(asctime)s | %(levelname)-8s | %(message)s",
                    datefmt="%H:%M:%S")

# ──────────────────────── DATACLASS SCHEMA HELPERS ──────────────────────
@dataclass
class ColumnNames:
    email: str            = "Resource_Email"
    hours: str            = "Total_Hours_By_week"
    week: str             = "Week"
    project_str: str      = "BG_Project_Code"
    project_core: str     = "Project STR Code"
    project_mile: str     = "Project_Code"

C = ColumnNames()          # shorthand

# ────────────────────────── GENERIC HELPERS ─────────────────────────────
def assert_exists(path: Path):
    if not path.exists():
        logging.error("Missing file: %s", path); sys.exit(1)

def load(path: Path) -> pd.DataFrame:
    assert_exists(path)
    return pd.read_excel(path)

def parse_week(val) -> pd.Timestamp | pd.NaT:
    """Accept YYYY-MM-DD or any ISO variant."""
    if pd.isna(val): return pd.NaT
    ts = pd.to_datetime(val, errors="coerce")
    if not pd.isna(ts): return ts.normalize()
    m  = ISO_RE.match(str(val).strip())
    if m:
        yr,wk = m.group("yr","wk")
        return pd.to_datetime(f"{yr}-W{wk}-1", format="%G-W%V-%u", errors="coerce")
    return pd.NaT

def add_iso_parts(df: pd.DataFrame, col: str="Week") -> pd.DataFrame:
    iso = df[col].dt.isocalendar()
    if isinstance(iso, pd.DataFrame):
        df["ISO_Year"]   = iso["year"].astype("float32")
        df["WeekOfYear"] = iso["week"].astype("float32")
    else:  # pandas<1.1
        df["ISO_Year"]   = [t[0] for t in iso]
        df["WeekOfYear"] = [t[1] for t in iso]
    return df

def build_lags_rolls(df: pd.DataFrame,
                     lags=(1,2,3,4), rolls=(4,8,12)) -> pd.DataFrame:
    for l in lags:
        df[f"lag{l}"] = df.groupby("Employee")["TotalHours"].shift(l)
    for r in rolls:
        df[f"roll{r}"] = (df.groupby("Employee")["TotalHours"]
                            .shift(1).rolling(r, min_periods=1).mean())
    return df

# ─────────────────────────── LOAD ALL DATA ──────────────────────────────
logging.info("Loading workbooks …")
df_str   = load(STR_PATH)
df_core  = load(CORE_PATH)
df_mile  = load(MILE_PATH)
df_empwl = load(EMP_PATH).rename(columns=lambda x: x.strip())

# ── employee whitelist to a set for fast lookup
EMP_SET = set(df_empwl.iloc[:,0].astype(str))

# ── convert STR week column
df_str[C.week] = df_str[C.week].apply(parse_week)
bad = df_str[C.week].isna().sum()
if bad:
    logging.warning("Dropped %d STR rows with unparseable Week", bad)
df_str = df_str[df_str[C.week].notna()].copy()

# ── keep only whitelist employees
df_str = df_str[df_str[C.email].astype(str).isin(EMP_SET)].copy()
logging.info("STR rows after whitelist filter : %d", len(df_str))

# ─── ensure milestone *_Completed columns are datetime
mile_date_cols = [c for c in df_mile.columns if c.lower().endswith("_completed")]
df_mile[mile_date_cols] = df_mile[mile_date_cols].apply(
    pd.to_datetime, errors="coerce"
)

# ─────────────────────── MEDIAN PROJECT WEEK LOAD ───────────────────────
proj_week = (
    df_str.groupby([C.project_str, C.week], as_index=False)[C.hours].sum()
          .rename(columns={C.hours:"Hours"})
)
MED_PROJ_WK_H = proj_week.groupby(C.project_str)["Hours"].mean().median()
logging.info("Median project weekly hours = %.1f", MED_PROJ_WK_H)

# ─────────────────────── AGGREGATE TO EMPLOYEE × WEEK ───────────────────
df_str = (
    df_str.groupby([C.email, C.week], as_index=False)
          .agg(TotalHours=(C.hours,"sum"))
          .rename(columns={C.email:"Employee", C.week:"Week"})
)
# nominal capacity rule
df_str["NominalCap"] = np.where(df_str["Week"] < pd.Timestamp("2025-01-01"),
                                HOURS_PRE25, HOURS_2025)

# ───────────────────── FLAG FREED EMPLOYEES (HORIZON) ───────────────────
cutoff_dt  = RUN_DATE + timedelta(days=HORIZON_DAYS)
closing_proj = df_mile.loc[
    df_mile[mile_date_cols].lt(cutoff_dt).any(axis=1), C.project_mile
].unique()
closing_emp  = df_core.loc[
    df_core[C.project_core].isin(closing_proj), "AssignedTo"
].unique()
df_str["WillFree"] = df_str["Employee"].isin(closing_emp).astype("float32")

# ─────────────────────── BUILD FEATURE TABLE ────────────────────────────
df_feat = add_iso_parts(build_lags_rolls(df_str.copy()))
emp2id  = {e:i for i,e in enumerate(df_feat["Employee"].unique())}
df_feat["EmpID"] = df_feat["Employee"].map(emp2id).astype("float32")

feature_cols = (
    ["ISO_Year","WeekOfYear","EmpID","NominalCap","WillFree"] +
    [c for c in df_feat.columns if c.startswith(("lag","roll"))]
)
df_feat = df_feat.dropna(subset=feature_cols+["TotalHours"]).copy()
df_feat[feature_cols] = df_feat[feature_cols].astype("float32")

# ───────────────────────── TRAIN MODEL ──────────────────────────────────
X, y = df_feat[feature_cols], df_feat["TotalHours"].astype("float32")
if HAS_XGB:
    model = XGBRegressor(
        n_estimators=500, learning_rate=0.05, max_depth=6,
        subsample=0.8, colsample_bytree=0.8, objective="reg:squarederror",
        n_jobs=-1, random_state=42
    )
else:
    model = RandomForestRegressor(n_estimators=400, n_jobs=-1, random_state=42)

tscv = TimeSeriesSplit(5)
mae_scores=[]
for tr, val in tscv.split(X):
    model.fit(X.iloc[tr], y.iloc[tr])
    mae_scores.append(mean_absolute_error(y.iloc[val], model.predict(X.iloc[val])))
logging.info("Time-series CV MAE = %.2f h", np.mean(mae_scores))
model.fit(X,y)

# ───────────────────────── 4-WEEK FORECAST ──────────────────────────────
horizon_weeks=4
blocks=[]
latest = df_feat.sort_values(["Employee","Week"]).groupby("Employee").tail(1)

for i in range(horizon_weeks):
    base = latest.copy() if i==0 else blocks[-1].copy()
    base["Week"] += Week(1)            # next Monday
    for l in LAG_W:                    # roll lag features
        base[f"lag{l}"] = base["TotalHours"] if l==1 else base[f"lag{l-1}"]
    base = add_iso_parts(base)
    base["EmpID"] = base["Employee"].map(emp2id).astype("float32")
    base[feature_cols] = base[feature_cols].astype("float32")
    base["TotalHours"] = model.predict(base[feature_cols]).astype("float32")
    base["WeekIdx"]    = i+1
    blocks.append(base)

fc = pd.concat(blocks, ignore_index=True)

# ────────────────── GAP, NEW PROJECTS, ASSIGNMENTS ──────────────────────
summary=[]
assignments=[]
for wk in range(1, horizon_weeks+1):
    wkdf      = fc[fc["WeekIdx"]==wk].copy()
    cap       = wkdf["NominalCap"].sum()
    demand    = wkdf["TotalHours"].sum()
    gap       = max(0, UTIL_TARGET*cap - demand)
    new_need  = int(np.ceil(gap / MED_PROJ_WK_H))
    summary.append((wk,cap,demand,gap,new_need))

    # greedy assignment to freed/most-spare employees
    wkdf["Spare"] = wkdf["NominalCap"] - wkdf["TotalHours"]
    wkdf = wkdf.sort_values("Spare", ascending=False)
    assigns=[]
    for _ in range(new_need):
        if wkdf["Spare"].max() <= 0: break
        idx = wkdf.index[0]
        assigns.append((wkdf.loc[idx,"Employee"], wkdf.loc[idx,"Spare"]))
        wkdf.loc[idx,"Spare"] -= MED_PROJ_WK_H
        wkdf = wkdf.sort_values("Spare", ascending=False)
    assignments.append(assigns)

# ─────────────────────────  MILestone watch  ────────────────────────────
nearest_mile = (df_mile
    .assign(**{
        "NearestDate": df_mile[mile_date_cols].min(axis=1)
    })
    .loc[lambda d: d["NearestDate"].notna(),
         [C.project_mile, "NearestDate"]]
    .sort_values("NearestDate")
)
nearest_mile = nearest_mile[nearest_mile["NearestDate"]>=RUN_DATE]\
               .head(10)

# ───────────────────────── REPORTS ───────────────────────────────────────
print("\n" + "="*70)
print(f"FORECAST WINDOW : {RUN_DATE.date()}  →  {(RUN_DATE+timedelta(days=HORIZON_DAYS)).date()}")
print(f"Employee whitelist count : {len(EMP_SET)}")
print(f"Median project weekly hrs: {MED_PROJ_WK_H:.1f}")
print("="*70)

print("\nWeekly capacity gap & projects needed")
print("Wk |   Cap   | Demand |  Gap  | NewProj | Top Assignments (emp → spare) ")
print("-"*72)
for (wk,cap,dem,gap,need), assigns in zip(summary, assignments):
    tops = "; ".join([f"{e}→{s:.0f}h" for e,s in assigns[:3]]) or "-"
    print(f"{wk:>2d} | {cap:7,.0f} | {dem:6,.0f} | {gap:6,.0f} | {need:7d} | {tops}")

print("-"*72)
print(f"TOTAL new projects next {horizon_weeks} weeks: {sum(s[-1] for s in summary)}")

print("\nNext milestones approaching")
if not nearest_mile.empty:
    print(nearest_mile.to_string(index=False, formatters={"NearestDate":lambda d:d.date()}))
else:
    print("No milestones within horizon")

print("="*70)
