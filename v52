// Step 1: Clear all but header
while (targetTable.getNumRows() > 1) {
  targetTable.removeRow(1);
}

// Step 2: Add HBOM rows (skip rows that are fully empty)
for (let i = 0; i < hwData.length; i++) {
  const hw = hwData[i] || [];
  const hwClean = hw.map(v => (v || '').toString().trim());

  // Skip completely empty rows
  if (hwClean.every(cell => cell === '')) continue;

  const row = targetTable.appendTableRow();
  row.appendTableCell(hwClean[3] || ''); // Category
  row.appendTableCell(hwClean[0] || ''); // Vendor/ Supplier
  row.appendTableCell(hwClean[1] || ''); // Component Name
  row.appendTableCell(hwClean[2] || ''); // Version/ Family
}

// Step 3: Add SBOM rows (skip rows that are fully empty)
for (let i = 0; i < swData.length; i++) {
  const sw = swData[i] || [];
  const swClean = sw.map(v => (v || '').toString().trim());

  // Skip completely empty rows
  if (swClean.every(cell => cell === '')) continue;

  const row = targetTable.appendTableRow();
  row.appendTableCell(swClean[0] || ''); // Category
  row.appendTableCell(swClean[1] || ''); // Vendor/ Supplier
  row.appendTableCell(swClean[2] || ''); // Component Name
  row.appendTableCell(swClean[3] || ''); // Version/ Family
}